    <Thickness x:Key="CardGap">4,0</Thickness>
    <Style x:Key="S" TargetType="Button"><Setter Property="Padding" Value="12" /></Style>
  </Page.Resources>
  <StackPanel Spacing="8">
    <TextBlock Margin="16" />
    <TextBlock Padding="0" />
